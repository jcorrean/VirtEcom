  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="test27" repetitions="1" sequentialRunOrder="false" runMetricsEveryStep="true">
      <setup>setup</setup>
      <go>go</go>
      <exitCondition><![CDATA[ticks >= 500]]></exitCondition>
      <metrics>
        <metric>mean [diversification] of sellers</metric>
        <metric>mean [ubiquity] of products</metric>
        <metric>mean [kc1] of sellers</metric>
        <metric>mean [kp1] of products</metric>
        <metric>count offers</metric>
        <metric>(count offers) / (count sellers * count products)</metric>
        <metric>mean [complexity] of sellers</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="Number-of-Sellers">
          <value value="20"></value>
          <value value="50"></value>
          <value value="100"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="Number-of-Customers">
          <value value="20"></value>
          <value value="100"></value>
          <value value="500"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="Number-of-Products">
          <value value="10"></value>
          <value value="25"></value>
          <value value="50"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
  </experiments>
</model>
