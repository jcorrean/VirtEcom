<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; ECONOMIC COMPLEXITY E-COMMERCE MODEL
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

globals [
  capability-universe
]

breed [sellers seller]
breed [products product]
breed [buyers buyer]
undirected-link-breed [offers offer]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; SELLERS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

sellers-own [
  capability-set
  revenue
  profit
  reputation
  complexity
  diversification
  kc1
]


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; BUYERS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

buyers-own [
  budget
  preferences
]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; PRODUCTS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

products-own [
  product-name
  required-capabilities
  product-category
  price
  quality
  complexity
  sales
  ubiquity
  kp1
]



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; SETUP
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to setup

  clear-all


  set capability-universe
  [
    "logistics"
    "marketing"
    "payments"
    "customer-service"
    "data-analytics"
    "cloud-computing"
    "ai-recommendation"
    "supplier-network"
    "warehousing"
    "last-mile-delivery"
  ]

  create-marketplace

  reset-ticks

end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; CREATE MARKETPLACE
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to create-marketplace

  create-sellers Number-of-Sellers
  [
    initialize-seller
  ]

  create-buyers Number-of-Customers
  [
    initialize-buyer
  ]

  create-global-products

  connect-sellers-to-products

  update-network-metrics

  update-reflections

end
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; INITIALIZE SELLER
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to initialize-seller

  set shape "person"
  set color blue
  set size 1.5

  setxy random-xcor random-ycor

  let n-capabilities 4 + random 4

  set capability-set n-of n-capabilities capability-universe

  set revenue 0
  set profit 0

  set reputation random-float 1

  set complexity length capability-set
  
  set diversification 0
  set kc1 0

end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; INITIALIZE BUYER
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to initialize-buyer

  set shape "person"
  set color red
  set size 1

  setxy random-xcor random-ycor

  set budget 100 + random 1000

  let n-preferences 1 + random 3

  set preferences
      n-of n-preferences capability-universe

end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; CREATE PRODUCTS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;to create-products-for-seller

 ; let my-capabilities capability-set

;  let n-products 1 + random 5

;  repeat n-products
;  [
;
;    hatch-products 1
;    [
;
;      set shape "box"
;      set color green
;      set size 1
;
;      rt random 360
;      fd 2
;
;      let n-required 1 + random (length my-capabilities)
;
;      set required-capabilities
;          n-of n-required my-capabilities
;
      ;; categoría principal del producto
;
;      set product-category
;          one-of required-capabilities
;
;      set complexity
;          length required-capabilities
;
;      set quality
;          1 + complexity
;
;      set price
;          50 + (complexity * 25)
;
;      set sales 0
;
;      set seller-id [who] of myself
;      create-offer-with myself
;[
;  set color gray
;]
;
;
;
;   ]
;  ]
;
;end

to create-global-products

  create-products Number-of-Products
  [

    set product-name
      word "Product-" who

    set shape "box"
    set color green
    set size 1.5

    setxy random-xcor random-ycor

    let n-required
      2 + random 4

    set required-capabilities
      n-of n-required capability-universe

    set product-category
      one-of required-capabilities

    set complexity
      length required-capabilities

    set quality
      complexity + 1

    set price
      50 + complexity * 25

    set sales 0

    set ubiquity 0

    set kp1 0

  ]

end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; PURCHASE PROCEDURE
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to make-purchase [chosen-product]

  let p [price] of chosen-product

  set budget budget - p

  ask chosen-product
  [
    set sales sales + 1
  ]

  let seller-agent
      one-of [link-neighbors] of chosen-product

  if seller-agent != nobody
  [
    ask seller-agent
    [
      set revenue revenue + p
      set profit profit + (0.30 * p)
    ]
  ]

end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; BUYING PROCESS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to market-step

  ask buyers
  [

    let affordable-products
        products with
        [
          price <= [budget] of myself
        ]

    if any? affordable-products
    [

      let preferred-products
          affordable-products with
          [
            member? product-category [preferences] of myself
          ]

      ;; compra preferida

      if any? preferred-products
      [

        let chosen-product
            max-one-of preferred-products
            [
              quality
            ]

        make-purchase chosen-product

      ]

      ;; si no encuentra preferencias

      if not any? preferred-products
      [

        let chosen-product
            one-of affordable-products

        make-purchase chosen-product

      ]

    ]

  ]

end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; LEARNING
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to learn-capabilities

  ask sellers
  [

    let probability-learning
        0.01 + (profit / 10000)

    if probability-learning > 1
    [
      set probability-learning 1
    ]

    if random-float 1 < probability-learning
    [

      let new-capability
          one-of capability-universe

      if not member? new-capability capability-set
      [
        set capability-set
            lput new-capability capability-set
      ]

    ]

    set complexity length capability-set

  ]

end

; Vendor-Product Connection
to connect-sellers-to-products

  ask sellers
  [

    let my-capabilities capability-set

    ask products
    [

      if is-subset? required-capabilities my-capabilities
      [

        create-offer-with myself
        [
          set color gray
        ]

      ]

    ]

  ]

end
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; INNOVATION
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to innovate

  ask sellers
  [

    let my-capabilities capability-set

    ask products
    [

      if not link-neighbor? myself
      [

        if is-subset? required-capabilities my-capabilities
        [

          create-offer-with myself
          [
            set color yellow
          ]

        ]

      ]

    ]

  ]

end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; UPDATE VISUALIZATION
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to update-colors

  ask sellers
  [
    set color scale-color blue complexity 1 10
  ]

  ask products
  [
    set color scale-color green complexity 1 10
  ]

end

; UPDATE NETWORK METRICS
to update-network-metrics

  ask sellers
  [
    set diversification count my-offers
  ]

  ask products
  [
    set ubiquity count my-offers
  ]

end

to update-reflections

  ask sellers
  [

    ifelse any? my-offers
    [
      set kc1
        mean [ubiquity]
        of link-neighbors
    ]
    [
      set kc1 0
    ]

  ]

  ask products
  [

    ifelse any? my-offers
    [
      set kp1
        mean [diversification]
        of link-neighbors
    ]
    [
      set kp1 0
    ]

  ]

end

to-report is-subset? [small-set big-set]

  report empty?
         filter
         [ x -> not member? x big-set ]
         small-set

end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; GO
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to go

  market-step

  learn-capabilities

  innovate

  update-network-metrics

  update-reflections

  update-colors

  tick

end
]]></code>
